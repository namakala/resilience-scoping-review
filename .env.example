# Groq API key (required)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: LLM model override (default: Mixtral or GPT OSS equivalent)
# MODEL_NAME=mixtral-8x7b-32768

# LLM temperature per inference stage (defaults: code=0.3, theme=0.4, interpretation=0.5)
# Higher values (e.g., 0.7) increase creativity; lower values (e.g., 0.1) increase determinism.
# CODE_TEMPERATURE=0.3
# THEME_TEMPERATURE=0.4
# INTERPRETATION_TEMPERATURE=0.5

# Optional: embedding model (default: all-MiniLM-L6-v2 per ADR-005)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: batch size for Groq inference (default: 15 exemplars per batch)
# BATCH_SIZE=15

# Optional: log level (default: INFO)
# LOG_LEVEL=INFO

# Optional: data paths (defaults shown)
# DATA_PATH=data/raw/data.csv
# TAGS_PATH=data/raw/tags.csv

# Base directory for processed artifacts (default: data/processed)
# Exemplars, tags, keywords Parquet files and BM25 index reside here.
# PROCESSED_DATA_PATH=data/processed

# Optional: sentence-transformer model cache directory (default: ~/.cache/huggingface/hub/)
# Used by generate_embedding() to cache the all-MiniLM-L6-v2 model on disk.
# Clear with clear_model_cache() or delete the models--sentence-transformers--all-MiniLM-L6-v2/ subdirectory.
# MODEL_CACHE_DIR=~/.cache/huggingface/hub

# BM25 tokenizer pipeline: comma-separated toggles (order applied sequentially).
# Valid toggles: lowercase, strip_punctuation, split_by_space, remove_stopword
# Default: lowercase,split_by_space (lowercase then whitespace tokenize)
# Example: BM25_TOKENIZER_CONFIG=lowercase,strip_punctuation,split_by_space,remove_stopword
# BM25_TOKENIZER_CONFIG=lowercase,split_by_space

# Optional: few-shot demonstration examples for LLM inference (default: true)
# Set to false to disable few-shot and run zero-shot.
# FEWSHOT_ENABLED=true

# Optional: number of few-shot examples per inference call (default: 2)
# FEWSHOT_COUNT=2

# Optional: randomize which examples are selected (default: false)
# FEWSHOT_SHUFFLE=false

# Token tracking cost configuration (Feature 34)
# Cost per 1M input tokens in USD (default: 0.15)
# TOKEN_COST_INPUT_PER_MILLION=0.15

# Cost per 1M output tokens in USD (default: 0.60)
# TOKEN_COST_OUTPUT_PER_MILLION=0.60

# Warning threshold for per-stage cost in USD (default: 1.00)
# MAX_STAGE_COST_USD=1.00
