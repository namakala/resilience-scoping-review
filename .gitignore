# Blacklist everything
*

# Whitelist directory contents
!*/

# Environment files: ignore .env, but track .env.example and environment.yaml
.env*
*.env
!.env.example
!environment.yaml

# Track specific filetypes
!*R
!*py
!*sql
!*sh
!*md
!*lock
!LICENSE
!*ignore
!*profile
!*toml
!README*
!*bib
!*yml
!*yaml
!*.tex
!.Renviron

# Output data (generated)
data/output/

# Python bytecode
__pycache__/
*.py[cod]
